// CHC CMS — Prisma Schema (MongoDB)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  email         String    @unique
  passwordHash  String
  name          String
  role          UserRole  @default(ADMIN)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  sessions      Session[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model LoginAttempt {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier  String
  attemptedAt DateTime @default(now())
  success     Boolean  @default(false)

  @@index([identifier, attemptedAt])
  @@map("login_attempts")
}

model RateLimitBucket {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
  @@map("rate_limit_buckets")
}

enum UserRole {
  ADMIN
  SUPER_ADMIN
}

// ─── Media ───────────────────────────────────────────────────────────────────

model MediaAsset {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  filename     String
  storageKey   String      @unique
  publicUrl    String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  altText      String      @default("")
  uploadedById String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  contentBlocks ContentBlock[]

  @@map("media_assets")
}

// ─── Pages & Content ─────────────────────────────────────────────────────────

model Page {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  slug        String      @unique
  title       String
  isPublished Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  createdById String
  updatedById String

  sections    Section[]
  seoMeta     SeoMeta?

  @@map("pages")
}

model Section {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  pageId      String        @db.ObjectId
  sectionKey  String
  sortOrder   Int           @default(0)
  isVisible   Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdById String
  updatedById String

  page        Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  blocks      ContentBlock[]

  // A page may use the same reusable section template more than once.
  // Ordering is stored per instance in sortOrder.
  @@index([pageId, sectionKey])
  @@map("sections")
}

model ContentBlock {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  sectionId    String        @db.ObjectId
  fieldKey     String
  blockType    BlockType
  textValue    String?
  mediaAssetId String?       @db.ObjectId
  sortOrder    Int           @default(0)
  isPublished  Boolean       @default(false)
  parentId     String?       @db.ObjectId
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdById  String
  updatedById  String

  section      Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset?   @relation(fields: [mediaAssetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent       ContentBlock? @relation("BlockChildren", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children     ContentBlock[] @relation("BlockChildren")

  @@index([sectionId, fieldKey])
  @@map("content_blocks")
}

enum BlockType {
  TEXT
  RICH_TEXT
  IMAGE
  URL
  SELECT
}

// ─── Navigation ──────────────────────────────────────────────────────────────

model NavigationItem {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  label       String
  href        String
  sortOrder   Int       @default(0)
  badge       String?
  icon        String?
  description String?
  parentId    String?   @db.ObjectId
  isVisible   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  updatedById String

  parent      NavigationItem?  @relation("NavChildren", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    NavigationItem[] @relation("NavChildren")

  @@map("navigation_items")
}

// ─── Footer ──────────────────────────────────────────────────────────────────

model FooterConfig {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  address1Label   String   @default("")
  address1Text    String   @default("")
  address2Label   String   @default("")
  address2Text    String   @default("")
  ctaText         String   @default("")
  ctaLinkText     String   @default("")
  ctaLinkHref     String   @default("")
  copyrightText   String   @default("")
  facebookUrl     String   @default("")
  instagramUrl    String   @default("")
  youtubeUrl      String   @default("")
  linkedinUrl     String   @default("")
  updatedAt       DateTime @updatedAt
  updatedById     String

  @@map("footer_config")
}

// ─── SEO ─────────────────────────────────────────────────────────────────────

model SeoMeta {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  pageId          String   @unique @db.ObjectId
  metaTitle       String   @default("")
  metaDescription String   @default("")
  ogTitle         String   @default("")
  ogDescription   String   @default("")
  ogImageUrl      String   @default("")
  canonical       String   @default("")
  noIndex         Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  updatedById     String

  page            Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("seo_meta")
}

// ─── Form Submissions ────────────────────────────────────────────────────────

model FormSubmission {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  formType    FormType
  data        Json
  submittedAt DateTime       @default(now())
  ipAddress   String?
  isRead      Boolean        @default(false)
  formDefinitionId String?   @db.ObjectId

  formDefinition FormDefinition? @relation(fields: [formDefinitionId], references: [id], onDelete: SetNull)

  @@index([formType, submittedAt])
  @@map("form_submissions")
}

enum FormType {
  CONTACT
  GIVE_ONE_HOUR
  CUSTOM
}

// ─── Dynamic Forms & Page Templates ──────────────────────────────────────────

model FormDefinition {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  slug           String   @unique
  title          String
  buttonText     String   @default("Submit")
  successMessage String   @default("Submitted successfully.")
  isActive       Boolean  @default(true)
  fields         Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?  @db.ObjectId
  updatedById    String?  @db.ObjectId

  submissions FormSubmission[]

  @@map("form_definitions")
}

model PageTemplate {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  content     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("page_templates")
}

// ─── Audit Log ───────────────────────────────────────────────────────────────

model AuditLog {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  action      String
  entityType  String?
  entityId    String?
  metadata    Json?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
